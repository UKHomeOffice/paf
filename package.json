{
  "name": "paf",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "main": "index.js",
  "engines": {
    "node": ">=24.22.2 <25.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UKHomeOffice/paf.git"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "[ -f .env ] && hof-build watch --env || hof-build watch",
    "test": "NODE_ENV=test yarn run test:lint && yarn run test:unit && yarn run test:ui-integration",
    "test:lint": "eslint . --config ./node_modules/eslint-config-hof/default.js",
    "test:ui-integration": "NODE_ENV=test _mocha \"test/_ui-integration/**/*.spec.js\" --exit",
    "test:unit": "NODE_ENV=test nyc _mocha \"test/_unit/**/*.spec.js\"",
    "bddgen": "bddgen",
    "test:e2e": "bddgen && playwright test",
    "build": "hof-build",
    "postinstall": "yarn run build"
  },
  "dependencies": {
    "accessible-autocomplete": "^3.0.1",
    "bl": "^7.0.14",
    "busboy": "^1.6.0",
    "form-data": "^4.0.6",
    "hof": "~24.7.2",
    "lodash": "^4.18.1",
    "sqs-producer": "^9.0.5",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "chai-subset": "^1.6.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "eslint": "^8.57.0",
    "eslint-config-hof": "^1.3.4",
    "jsdom": "^30.0.0",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "playwright": "1.65.0",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.9.9",
    "proxyquire": "^2.1.3",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "supertest": "^7.3.2",
    "supertest-session": "^5.0.1",
    "typescript": "^7.0.2"
  },
  "mocha": {
    "reporter": "spec",
    "require": "test/setup.js",
    "recursive": "true",
    "timeout": "9000"
  },
  "keywords": [],
  "author": ""
}
